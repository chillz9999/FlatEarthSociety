# Public configuration for the website (baked in at build time).
NEXT_PUBLIC_API_URL=http://localhost:4000
# Robinhood Chain testnet 46630 / mainnet 4663 — verify RPC and explorer against the official docs.
NEXT_PUBLIC_CHAIN_ID=46630
NEXT_PUBLIC_CHAIN_NAME=
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_EXPLORER_URL=
# Optional: enables WalletConnect alongside browser wallets.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# The site's public address, included in shared scores (defaults to https://wif-web.vercel.app).
NEXT_PUBLIC_SITE_URL=
