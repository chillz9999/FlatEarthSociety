# ---- Society API configuration (see docs/DEPLOYMENT.md) ----
PORT=4000
# Production: a PostgreSQL URL. Omit to use an embedded PGlite database in PGLITE_DIR (development only).
# DATABASE_URL=postgres://user:password@host:5432/flat_earth_society
PGLITE_DIR=.data/pglite
# The web app origin(s), comma-separated. Also used to validate Sign-In with Ethereum domains.
WEB_ORIGIN=http://localhost:3000
# REQUIRED in production: at least 32 random characters, e.g. `openssl rand -hex 32`.
SESSION_SECRET=
# Wallets allowed into the admin console (comma-separated).
ADMIN_ADDRESSES=

# ---- Chain ----
# enabled | disabled (disabled = practice + read-only leaderboards, no ranked play)
CHAIN_MODE=enabled
# Robinhood Chain testnet 46630 / mainnet 4663 — verify against the official docs before deploying.
CHAIN_ID=46630
RPC_URL=
EXPLORER_URL=
# Either point at the deployment file written by contracts/script/Deploy.s.sol …
DEPLOYMENT_FILE=../../contracts/deployments/46630.json
# … or give the addresses explicitly:
# ENTRY_CONTRACT=0x...
# VAULT_CONTRACT=0x...
# CONVERTER_CONTRACT=0x...
# START_BLOCK=
CONFIRMATIONS=2
INDEXER_INTERVAL_MS=8000
# Key holding SETTLER_ROLE on the prize vault (convert / finalize / claimFor). Keep it in a secret manager.
SETTLER_PRIVATE_KEY=
# Key holding PRICER_ROLE on the entry contract (re-prices the fees). Defaults to the settler key.
# PRICER_PRIVATE_KEY=

# ---- Prices (docs/ECONOMY.md) ----
# Dollar prices of a ranked voyage and of its one bonus life; the fees are kept at these in WIF.
ENTRY_PRICE_USD=0.1
EXTRA_LIFE_PRICE_USD=5
# dexscreener | coingecko | fixed | off
PRICE_FEED=off
# DexScreener's id for Robinhood Chain (dexscreener.com/<chain>/…); unset = any chain.
# DEXSCREENER_CHAIN=
PRICE_MIN_LIQUIDITY_USD=25000
# Optional CoinGecko id: the feed for PRICE_FEED=coingecko, a cross-check otherwise.
# COINGECKO_ID=
PRICE_MAX_DISAGREEMENT_BPS=1500
# For PRICE_FEED=fixed: the price of one WIF in dollars.
# WIF_USD=
PRICE_DEVIATION_BPS=500
PRICE_UPDATE_INTERVAL_MS=600000
AUTO_SETTLE=false
CONVERSION_SLIPPAGE_BPS=100
CLOSE_GRACE_MINUTES=40
REVIEW_TOP_N=10
AUTO_RESTORE_PER_WEEK=1
# Behind a reverse proxy: its address(es) or hop count, so rate limits see the real client IP.
TRUST_PROXY=false
LOG_LEVEL=info
